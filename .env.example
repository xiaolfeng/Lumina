# ============================================
# Application
# ============================================
# 调试模式（true=开启）：生产环境务必设为 false，避免 Swagger 暴露与调试日志泄露
XLF_DEBUG=false
XLF_HOST=0.0.0.0
XLF_PORT=8080
APP_NAME=Lumina
APP_VERSION=v0.1.0

# ============================================
# PostgreSQL
# ============================================
DATABASE_DRIVER=postgres                # 必填：数据库驱动（postgres/mysql/sqlite/oracle/sqlserver；空=none 不启用）
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=bamboo_user
DATABASE_PASS=bamboo_pass
DATABASE_NAME=lumina
DATABASE_PREFIX=lum_
DATABASE_TIMEZONE=Asia/Shanghai

# ============================================
# Redis
# ============================================
NOSQL_DRIVER=redis                      # 必填：缓存驱动（redis/memory/none；空=none 不启用）
NOSQL_HOST=localhost
NOSQL_PORT=6379
NOSQL_USER=                             # Redis ACL 用户名（非 ACL 模式留空）
NOSQL_PASS=
NOSQL_DATABASE=1
NOSQL_PREFIX=lum:
NOSQL_POOL_SIZE=100

# ============================================
# Snowflake (Optional)
# ============================================
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_NODE_ID=1

# ============================================
# Q&A Configuration
# ============================================
# QA_SESSION_TTL=172800                  # Session默认TTL（秒），默认48小时

# Q&A 文件缓存目录（image/file 回答的 base64 文件存储）
LUMINA_CACHE_DIR=.lumina/cache

# ============================================
# WebAuthn 生物特征登录
# ============================================
# WebAuthn RP ID：未配置或与访问域名不一致时，将自动按请求 Origin 的 Hostname
# 推导（线上部署无需修改）。可配置为注册域后缀以支持子域共享凭证（如
# app.example.com → example.com），此时该域名需提供 .well-known/webauthn 资源。
XLF_BIOMETRIC_RP_ID=localhost
XLF_BIOMETRIC_RP_NAME=Lumina
# 允许的 Origin，逗号分隔；请求的实际 Origin 会自动并入，远程部署无需手动追加
XLF_BIOMETRIC_ORIGIN=http://localhost:8080,http://localhost:3000
# WebAuthn 动态推导域名白名单（可选，逗号分隔，须含 scheme，如 https://app.example.com）：
# 设置后仅允许白名单内的域名做动态 RPID 推导，阻止 DNS-rebinding 把凭证绑定到恶意域名；
# 留空则保持自动推导。
XLF_BIOMETRIC_ALLOWED_ORIGINS=

# ============================================
# 安全 / 初始化
# ============================================
# 一次性初始化令牌：设置后 POST /auth/initialize 必须携带匹配的 setup_token，
# 防止公开初始化接口在首次初始化窗口内被未认证攻击者抢先接管管理员账户。
# 生产部署强烈建议设置为高强度随机串；留空则退化为仅依赖原子初始化（防并发 TOCTOU）。
XLF_INITIALIZE_TOKEN=

# CORS 跨域白名单（逗号分隔 Origin）：仅允许白名单内的源跨域访问 API。
# 生产部署为前后端同源、无需 CORS；开发环境默认放行前端 Vite 服务器。
XLF_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# RepoWiki Configuration
# ============================================
REPOWIKI_STORAGE_PATH=./.lumina/repowiki
REPOWIKI_MAX_CONCURRENT=1              # 同时进行的分析任务数
# Wiki 访问 Cookie 的 HMAC 签名密钥；留空时自动生成进程级随机密钥（重启后已签发的
# Cookie 会失效）。生产部署建议设置为固定高强度随机串，保证重启后 Wiki 会话不失效。
REPOWIKI_HMAC_SECRET=

# RepoWiki 编排引擎超时/配额/重试控制
REPOWIKI_PIPELINE_TIMEOUT_MIN=60       # Pipeline 总超时（分钟）
REPOWIKI_OVERVIEW_TIMEOUT_MIN=10       # Coordinator 概要阶段超时（分钟）
REPOWIKI_EXPLORE_TIMEOUT_MIN=15         # Explore 每路超时（分钟）
REPOWIKI_ARCHITECT_TIMEOUT_MIN=10      # Architect 阶段超时（分钟）
REPOWIKI_WRITER_TIMEOUT_MIN=20         # Writer 每批超时（分钟）
REPOWIKI_VALIDATOR_TIMEOUT_MIN=5       # Validator 阶段超时（分钟）
REPOWIKI_EXPLORE_MAX_CONCURRENT=4      # Explore 最大并发数
REPOWIKI_WRITER_MAX_CONCURRENT=4       # Writer 最大并发数
REPOWIKI_WRITER_MAX_RETRY=2            # Writer 失败最大重试次数
REPOWIKI_MAX_TOKENS=2000000            # 每个 version 总 token 上限
REPOWIKI_MAX_REPO_SIZE_MB=2048         # 单仓库磁盘上限（MB）
REPOWIKI_MAX_VERSIONS=10               # 每个 config 保留版本数上限

# RepoWiki 异步任务配置
REPOWIKI_TASK_TIMEOUT=1800             # 任务超时判定阈值（秒，cron 用）
REPOWIKI_MAX_RETRY=3                   # 失败任务最大重试次数，默认 3

# ============================================
# LLM Configuration (Hot Config)
# ============================================
# LLM Provider/Model 配置已迁移到数据库，通过前端管理页面配置
# 此密钥用于加密 LLM API Key 与 SSH 私钥（AES-256-GCM），必填
LLM_ENCRYPT_SECRET=
