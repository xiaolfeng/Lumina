# =============================================================================
# Lumina · 微明 发布运行镜像（直接消费 GoReleaser 预编译二进制）
#   基础环境：alpine 3.21 + CA 证书 + tini + tzdata（Asia/Shanghai）
#   产物消费：通过 Docker Buildx TARGETARCH 自动适配 amd64 / arm64 架构
# =============================================================================

FROM alpine:3.21 AS runtime

# CA 证书（HTTPS 克隆 / LLM API 调用）+ 优雅退出 init + 时区数据（系统时间 Asia/Shanghai）
RUN apk add --no-cache \
    ca-certificates \
    tini \
    tzdata

ENV TZ=Asia/Shanghai

WORKDIR /app

# Docker Buildx 自动注入目标架构 (amd64 / arm64)
ARG TARGETARCH
COPY dist/lumina_linux_${TARGETARCH}*/lumina /app/lumina

RUN chmod +x /app/lumina && \
    mkdir -p /app/.lumina/repowiki /app/.lumina/cache

EXPOSE 8800

# tini 作为 PID 1 转发 SIGTERM/SIGINT，保证框架 Runner 优雅退出
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/app/lumina"]
